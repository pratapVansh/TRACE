# =============================================================================
# TRACE — Environment Variables (copy to .env and adjust)
# =============================================================================

# PostgreSQL
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trace

# Async SQLAlchemy URL (backend runtime)
DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5432/trace

# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://trace:trace@localhost:5432/trace

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js — exposed to browser must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT
# REQUIRED. The app refuses to start if this is empty, and rejects this
# placeholder value unless DEBUG=true. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh-token cookie (httpOnly — keeps the long-lived token out of JS)
# REFRESH_COOKIE_SECURE must be true when serving over HTTPS.
# REFRESH_COOKIE_SAMESITE: "lax" is the CSRF defence for /auth/refresh.
#   Only use "none" (with secure=true) if the frontend is on a different
#   registrable domain than the API — that combination needs a CSRF token.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=

# Demo routes (/api/demo/*)
# A walkthrough-only endpoint that shows RBAC rejecting an under-privileged
# user. Not part of the product surface — leave off outside a demo.
DEMO_ROUTES_ENABLED=false

# Document storage (Milestone 4+)
# OCR (Tesseract)
# Tesseract is a separate native binary and must be installed for scanned
# PDFs and images to yield any text at all:
#   Windows:  winget install UB-Mannheim.TesseractOCR
#   macOS:    brew install tesseract
#   Debian:   sudo apt install tesseract-ocr
# Set TESSERACT_CMD when the binary is not on PATH (the Windows default):
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_LANGUAGE accepts "eng" or a combination like "eng+deu"; the traineddata
# for each language must be installed alongside Tesseract.
OCR_LANGUAGE=eng
# Tesseract is trained on ~300 DPI; lowering this loses accuracy on small type.
OCR_RENDER_DPI=300
# Extractions scoring below this mean word confidence are flagged for review.
OCR_MIN_CONFIDENCE=0.5

# Retrieval reranking
# A cross-encoder rescores retrieved chunks by reading the query and chunk
# together, which ranks far better than embedding similarity alone. The model
# downloads on first use; if it cannot load, retrieval still works and simply
# keeps its original order.
RERANK_ENABLED=true
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Budget for one scoring call. Exceeding it drops back to retrieval order
# and switches reranking off for the process, so a stalled model cannot
# queue every later request behind it. The model is loaded at startup,
# not on the first query.
RERANK_TIMEOUT_SECONDS=10.0

STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,pptx,xlsx,txt,png,jpg,jpeg

# Bootstrap SuperAdmin (first organization owner — used by create_super_admin.py)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=

# Qdrant Vector Store (Milestone 7+)
# For a local instance use http://127.0.0.1:6333, NOT http://localhost:6333 —
# "localhost" resolves to ::1 first and Qdrant listens on IPv4 only, so every
# call waits out a failed IPv6 connection first (measured: 2055ms/call versus
# 11ms/call). Cloud URLs are unaffected.
QDRANT_URL=
QDRANT_API_KEY=

# LLM / AI Copilot (Milestone 8)
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Neo4j Knowledge Graph (Milestone 9)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Retrieval (Milestone 8.1)
RETRIEVAL_TOP_K=15
RETRIEVAL_SIMILARITY_THRESHOLD=0.25
RETRIEVAL_DEDUP_DOCUMENTS=True

# External service timeouts and retries
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3