# =============================================================================
# TRACE — container environment. Copy to .env.docker and edit.
#
#     cp .env.docker.example .env.docker
#
# This is NOT the same file as ./.env. Two different mechanisms read them:
#
#   ./.env         Compose reads this to interpolate ${...} in the compose
#                  files themselves (POSTGRES_USER, BACKEND_PORT, ports). It
#                  also holds the host-side settings for running the backend
#                  from a venv, where "localhost" is the right hostname.
#   ./.env.docker  Passed into the containers as their environment. Hostnames
#                  here are compose service names, and paths are container
#                  paths.
#
# Keeping them separate is what stops a host .env — with localhost database
# URLs and a Windows Tesseract path — from being handed to a Linux container
# where none of it resolves.
#
# Two flavours below. FLAVOUR A is active and points at the containers in
# docker-compose.local.yml. FLAVOUR B is commented out and points at managed
# cloud services; swap the corresponding lines to use it.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------
# The app refuses to start with this empty, and rejects the placeholder value
# unless DEBUG=true. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# =============================================================================
# FLAVOUR A — local service names (docker-compose.local.yml)
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Host is "postgres", the compose service name, not localhost: inside the
# backend container localhost is the backend itself.
# Both URLs are needed and are not interchangeable — the app talks asyncpg,
# Alembic talks psycopg2.
DATABASE_URL=postgresql+asyncpg://trace:trace@postgres:5432/trace
DATABASE_URL_SYNC=postgresql+psycopg2://trace:trace@postgres:5432/trace

# --- Qdrant -------------------------------------------------------------------
# Set by docker-compose.local.yml as well; kept here so the value is visible
# and so the base stack alone can be pointed somewhere.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

# --- Neo4j --------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tracedevpassword
NEO4J_DATABASE=neo4j


# =============================================================================
# FLAVOUR B — managed cloud services
#
# Run the base stack only (no -f docker-compose.local.yml) and comment out
# FLAVOUR A above. Postgres can stay containerised or move to a managed
# instance; the two halves are independent.
# =============================================================================

# --- Managed PostgreSQL -------------------------------------------------------
# Note the different TLS parameter on each side. This is a real difference, not
# a typo: psycopg2 understands libpq's sslmode, asyncpg does not and takes ssl.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db.example.neon.tech:5432/trace?ssl=require
# DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@db.example.neon.tech:5432/trace?sslmode=require

# --- Qdrant Cloud -------------------------------------------------------------
# Include the port explicitly; the cluster's REST port is 6333 over TLS.
# QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=document_chunks

# --- Neo4j Aura ---------------------------------------------------------------
# neo4j+s:// — the routing-and-TLS scheme Aura requires. bolt:// will not
# connect, and neo4j:// without the +s fails the certificate check.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j


# =============================================================================
# Shared — same for both flavours
# =============================================================================

# --- Server -------------------------------------------------------------------
# 0.0.0.0 so the port is reachable from outside the container. 127.0.0.1 here
# is the classic "the container is healthy but nothing answers" mistake.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Refresh-token cookie -----------------------------------------------------
# REFRESH_COOKIE_SECURE must be true once served over HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Storage ------------------------------------------------------------------
# Container path, backed by the backend_storage named volume. Changing it
# without changing the volume mount in docker-compose.yml puts uploads back in
# the container's writable layer, where a rebuild destroys them.
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
WORKSPACE_ROOT=/app/workspace
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,pptx,xlsx,txt,png,jpg,jpeg

# --- OCR ----------------------------------------------------------------------
# TESSERACT_CMD stays EMPTY. The image installs tesseract on PATH; a value
# copied from a host .env (C:/Program Files/Tesseract-OCR/tesseract.exe) points
# at a path that does not exist in the container and silently disables OCR.
TESSERACT_CMD=
# The image bakes traineddata for every language OcrEngine accepts:
# eng fra deu spa ita por nld ara chi_sim jpn kor. Combine with "+", e.g. eng+deu.
OCR_LANGUAGE=eng
OCR_RENDER_DPI=300
OCR_MIN_CONFIDENCE=0.5

# --- Models -------------------------------------------------------------------
# Both are baked into the image under HF_HOME=/opt/models, so the container
# starts without contacting huggingface.co. Changing either name here means
# the new weights are NOT in the image and will be downloaded on first use —
# rebuild with the matching build args instead.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANK_ENABLED=true
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TIMEOUT_SECONDS=10.0
# The image sets HF_HUB_OFFLINE=1 and TRANSFORMERS_OFFLINE=1, so no model
# traffic ever leaves the container and startup does not depend on
# huggingface.co being reachable. Both models are in the image, so there is
# nothing to fetch.
#
# Consequence: changing either model name above without rebuilding the image
# with the matching build args fails at startup instead of silently downloading
# different weights. To go back to fetching on demand, set HF_HUB_OFFLINE=0 and
# TRANSFORMERS_OFFLINE=0 here.

# --- Chunking -----------------------------------------------------------------
CHUNK_SIZE=256
CHUNK_OVERLAP=40

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=15
RETRIEVAL_SIMILARITY_THRESHOLD=0.0
RETRIEVAL_DEDUP_DOCUMENTS=True

# --- LLM ----------------------------------------------------------------------
# Optional. Left empty the API still uploads, processes, indexes and retrieves;
# only Copilot answer generation is unavailable.
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3

# --- External service timeouts ------------------------------------------------
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3

# --- Misc ---------------------------------------------------------------------
DEBUG=false
DEMO_ROUTES_ENABLED=false
PROCESSING_QUEUE_WORKER_ENABLED=true
